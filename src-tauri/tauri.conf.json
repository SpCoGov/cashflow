{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cashflow",
  "version": "0.1.0",
  "identifier": "top.spco.cashflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cashflow",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SpCo",
    "icon": ["icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["cflg"],
        "name": "Cashflow Ledger File",
        "description": "Cashflow Ledger File",
        "mimeType": "application/x-cashflow-ledger",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
